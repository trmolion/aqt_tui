/* Общий стиль для всех блоков-контейнеров */
#left_panel, #right_panel {
    border: solid rgb(34, 148, 34);       /* рамка */
    padding: 1;                   /* отступ внутри */
    margin: 1;                   /* отступ снаружи */
    background: $surface;         /* фон */
}

/* Заголовок внутри каждого блока (Label) */
#left_panel > Label,
#right_panel > Label {
    background: $surface;
    color: red;
    padding: 0 2;
    width: auto;
    height: 1;
    text-style: bold;
    offset-x: -2;
}

#left_panel {
    width: 30%;
    padding: 1;
}

#right_panel {
    width: 70%;
    padding: 1;
}

#left_panel Button {
    width: 100%;
    margin: 1;
}

#progress_container {
    width: 100%;
    height: auto;
    padding: 1;
}

ProgressBar {
    width: 100%;
    margin-top: 1;
}

Label {
    width: 100%;
    text-style: bold;
}

Tree {
    width: 100%;
    height: 100%;
}

Button:hover {
    background: rgb(90, 128, 233);
}

#path_label {
    text-align: center;
    text-style: bold;
}